#!/bin/sh
# {{ ansible_managed }}
# CIS Debian 13 1.4.1 - bootloader password. Menuentries keep --unrestricted so
# the default entry boots without a password; this only guards edit / the shell.
set -e
cat <<'EOF'
set superusers="{{ bootloader_superuser }}"
password_pbkdf2 {{ bootloader_superuser }} {{ bootloader_password_hash }}
EOF
