# apparmor=1 and security=apparmor are required literally on the linux line for
# CIS 1.3.1.2 (SSG grub2_enable_apparmor). lsm= takes precedence over security=,
# so security=apparmor is only a scanner token; lsm= decides the active LSMs.
GRUB_CMDLINE_LINUX_DEFAULT="${GRUB_CMDLINE_LINUX_DEFAULT:+$GRUB_CMDLINE_LINUX_DEFAULT }lsm=capability,apparmor,yama apparmor=1 security=apparmor"
